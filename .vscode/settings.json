{
  // Positron / VS Code workspace settings for this project.
  // Interpreter: the project virtual environment created by `uv sync` or `pip`.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  // Let editor analysis resolve the project's `src` package from any file.
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  // Ruff (bundled with Positron) should use the project interpreter.
  "ruff.interpreter": ["${workspaceFolder}/.venv/bin/python"],

  // Tests: pytest, discovered from tests/.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Quarto: Positron bundles Quarto, so no path is needed. Render previews
  // open in the Viewer pane; the HTML format is the default.
  "quarto.render.previewType": "internal",
  "quarto.render.renderOnSave": false,

  // Editor conventions used across the repo.
  "editor.rulers": [120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": { "editor.tabSize": 4 },
  "[quarto]": { "editor.wordWrap": "on" },
  "[markdown]": { "editor.wordWrap": "on" },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    ".quarto": true
  }
}
